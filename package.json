{
  "name": "tetris-multiplayer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "lint": "yarn lint:ts && yarn lint:md",
    "lint:ts": "TURBO_TELEMETRY_DISABLED=1 turbo run lint",
    "lint:md": "markdownlint-cli2",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
    "clean": "TURBO_TELEMETRY_DISABLED=1 turbo run clean",
    "check": "yarn constraints && yarn lint:md && TURBO_TELEMETRY_DISABLED=1 turbo run lint build typecheck test"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@yarnpkg/types": "4.0.1",
    "eslint": "10.14.0",
    "markdownlint-cli2": "0.24.1",
    "turbo": "2.11.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  }
}
