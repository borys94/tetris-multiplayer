{
  "name": "tetris-multiplayer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
    "clean": "TURBO_TELEMETRY_DISABLED=1 turbo run clean",
    "check": "yarn constraints && TURBO_TELEMETRY_DISABLED=1 turbo run build typecheck test"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@yarnpkg/types": "4.0.1",
    "turbo": "2.11.11"
  }
}
