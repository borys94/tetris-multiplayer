{
  "name": "@tetris/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node26 --format=cjs --minify --sourcemap --outfile=dist/main.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tetris/game-core": "workspace:*",
    "@tetris/protocol": "workspace:*",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0"
  }
}
